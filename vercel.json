{
  "rewrites": [
    {
      "source": "/api/faucet",
      "destination": "/api/faucet"
    },
    {
      "source": "/api/notify",
      "destination": "/api/notify"
    },
    {
      "source": "/api/payments/(.*)",
      "destination": "/api/payments?id=$1"
    },
    {
      "source": "/api/payments",
      "destination": "/api/payments"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
